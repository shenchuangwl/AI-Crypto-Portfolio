# Optional secrets for local/dev (DO NOT commit real keys)
# Copy to monorepo root .env or export in shell.

# CoinGecko Demo key: x-cg-demo-api-key on api.coingecko.com
# CoinGecko Pro key:  x-cg-pro-api-key on pro-api.coingecko.com
COINGECKO_API_KEY=
# 1 = pro host. Leave 0 for Demo keys (default).
COINGECKO_USE_PRO=0
# Optional base override
# COINGECKO_BASE=https://api.coingecko.com/api/v3
# Alias read when COINGECKO_API_KEY is empty (use only one of them)
# CG_API_KEY=

# 注意：.env 会被 coin-selection 扫描、以及 scripts/daemonize.py（start-all.sh）拉起的
# 服务自动注入（已存在的进程环境优先）。直接运行 mock_server.py / python -m market_ingest
# 时不读取 .env，需自行 export。PORT / HOST 由 daemonize.py 从 shell 环境读取，写在 .env 中无效。
# —— OnlyCoin 候选源控制写接口 PUT /api/v1/onlycoin/sources/screener-y/control ——
# 未设置时该写接口返回 503（fail closed）。请自行生成高强度随机值，切勿提交真实值。
# ONLYCOIN_ADMIN_TOKEN=

# —— 端口 / 服务地址（不设则用默认值）——
# PORT=18080
# MARKET_INGEST_PORT=18100
# MARKET_INGEST_URL=http://127.0.0.1:18100

# Combined stream only (default). Do not add /ws — it can connect then stay silent.
# BINANCE_FAPI_WS_PATHS=/stream
# BINANCE_FAPI_WS=wss://fstream.binancefuture.com
# REST_PRICE_POLL_SEC=12

# —— 板面变体（选币榜 / 选币榜X / 选币榜Y）——
# 注册表在 packages/config/board-variants.json；下面只是运行期的临时开关。
# 选币榜X v1.3.0 当前复刻 main v1.4.0；独立复盘闭环与 shadow 四列，候选不可执行。
# 0/false/no/off = 暂停 X 投影与 /api/v1/screener-x；扫描器和网关须同步设置。
# 唯一调参入口仍是 boards[key=x].overrides（同步 X YAML），本变量不改变策略。
# ENABLE_BOARD_X=1
# 0/false/no = 关停「选币榜Y」(param-v2.0.0-screener-y)：主扫描不再投影它，
# 网关不再暴露 /api/v1/screener-y。原「选币榜」不受任何影响。
# 扫描器与网关都读这个变量，要关就两边一起关。
# ENABLE_BOARD_Y=1
# 注册表路径覆盖（冒烟/实验用，生产别动）
# BOARD_VARIANTS_CONFIG=/abs/path/board-variants.json
